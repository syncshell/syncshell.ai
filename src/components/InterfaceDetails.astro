---
import type { InterfaceData } from "../content.config"
import Screenshot from "./media/Screenshot.astro"
import Video from "./media/Video.astro"
type Props = InterfaceData
const { availability, statusNote, sourceUrl, releaseUrl, screenshots = [], videos = [] } = Astro.props
---

<div class="interface-meta">
  <span class:list={["status-badge", { "status-planned": availability === "Planned" }]}>{availability}</span>
  {sourceUrl && <a href={sourceUrl}>Source on GitHub</a>}
  {releaseUrl && <a href={releaseUrl}>Tagged releases</a>}
</div>
{statusNote && <p class="status-note">{statusNote}</p>}
{
  screenshots.length > 0 && (
    <div class="demo-screenshot-grid">
      {screenshots.map((shot) => (
        <figure class="demo-figure">
          <Screenshot image={shot} />
          <figcaption>{shot.caption}</figcaption>
        </figure>
      ))}
    </div>
  )
}
{
  videos.length > 0 && (
    <div class="demo-video-grid">
      {videos.map((video) => (
        <figure class="demo-figure">
          <Video video={video} />
          <figcaption>
            <span class="demo-caption-title">{video.title}</span>
            <span class="demo-caption-description">{video.description}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  )
}
