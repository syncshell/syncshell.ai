{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "syncshell-site",
  "compatibility_date": "2026-09-09",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "routes": [
    {
      "pattern": "syncshell.ai",
      "custom_domain": true,
    },
  ],
}
